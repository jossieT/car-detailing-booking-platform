generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id           String    @id @default(cuid())
  name         String
  address      String?
  phone        String?
  email        String?
  timezone     String    @default("UTC")
  workingHours Json?
  closedDays   Int[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  bookings     Booking[]
  services     Service[]
  users        User[]

  @@map("businesses")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole       @default(CUSTOMER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  businessId    String?
  auditLogs     AuditLog[]
  bookings      Booking[]      @relation("CustomerBookings")
  staffBookings Booking[]      @relation("StaffBookings")
  notifications Notification[]
  staffProfile  StaffProfile?
  skills           Service[]        @relation("StaffSkills")
  workingHours     WorkingHour[]
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([businessId])
  @@map("users")
}



model WorkingHour {
  id         String   @id @default(cuid())
  staffId    String
  staff      User     @relation(fields: [staffId], references: [id])
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime  String   // "09:00"
  endTime    String   // "17:00"
  isDayOff   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([staffId, dayOfWeek])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Service {
  id            String            @id @default(cuid())
  name          String            @unique
  description   String?
  duration      Int
  basePrice     Decimal           @db.Decimal(10, 2)
  isActive      Boolean           @default(true)
  imageUrl      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  parentId      String?           @map("parent_id")
  bufferMinutes Int               @default(30)
  capacity      Int               @default(1)
  businessId    String?
  bookings      Booking[]
  materials     ServiceMaterial[]
  business      Business?         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  parent        Service?          @relation("ServicePackage", fields: [parentId], references: [id])
  children      Service[]         @relation("ServicePackage")
  assignedStaff    User[]           @relation("StaffSkills")

  @@index([businessId])
  @@map("services")
}

model ServiceMaterial {
  id          String    @id @default(cuid())
  serviceId   String    @map("service_id")
  inventoryId String    @map("inventory_id")
  quantity    Int       @default(1)
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  service     Service   @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, inventoryId])
  @@map("service_materials")
}

model Inventory {
  id            String            @id @default(cuid())
  name          String
  sku           String            @unique
  category      String
  quantity      Int               @default(0)
  minThreshold  Int               @default(5)
  unit          String
  costPerUnit   Decimal           @db.Decimal(10, 2)
  sellingPrice  Decimal?          @db.Decimal(10, 2)
  location      String?
  lastRestocked DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  inventoryLogs InventoryLog[]
  materials     ServiceMaterial[]

  @@map("inventory")
}

model InventoryLog {
  id          String    @id @default(cuid())
  inventoryId String    @map("inventory_id")
  quantity    Int
  reason      String
  bookingId   String?   @map("booking_id")
  performedBy String    @map("performed_by")
  createdAt   DateTime  @default(now())
  booking     Booking?  @relation(fields: [bookingId], references: [id])
  inventory   Inventory @relation(fields: [inventoryId], references: [id])

  @@map("inventory_logs")
}

model Booking {
  id             String                 @id @default(cuid())
  customerId     String                 @map("customer_id")
  staffId        String?                @map("staff_id")
  serviceId      String                 @map("service_id")
  startTime      DateTime               @map("start_time")
  endTime        DateTime               @map("end_time")
  status         BookingStatus          @default(PENDING)
  totalPrice     Decimal                @db.Decimal(10, 2)
  depositPaid    Decimal?               @db.Decimal(10, 2)
  notes          String?
  internalNotes  String?
  vehicleInfo    Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  idempotencyKey String?                @unique @map("idempotency_key")
  businessId     String?
  statusHistory  BookingStatusHistory[]
  business       Business?              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer       User                   @relation("CustomerBookings", fields: [customerId], references: [id])
  service        Service                @relation(fields: [serviceId], references: [id])
  staff          User?                  @relation("StaffBookings", fields: [staffId], references: [id])
  inventoryLogs  InventoryLog[]
  payments       Payment[]

  @@index([startTime])
  @@index([staffId, startTime])
  @@index([customerId])
  @@index([businessId])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String        @map("booking_id")
  oldStatus BookingStatus
  newStatus BookingStatus
  changedBy String        @map("changed_by")
  reason    String?
  changedAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id])

  @@map("booking_status_history")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @map("booking_id")
  amount        Decimal       @db.Decimal(10, 2)
  method        String
  transactionId String?       @unique
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  receiptUrl    String?
  createdAt     DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model StaffProfile {
  id              String      @id @default(cuid())
  userId          String      @unique @map("user_id")
  position        String
  hourlyRate      Decimal     @db.Decimal(10, 2)
  hireDate        DateTime    @default(now())
  terminationDate DateTime?
  bankAccount     String?
  taxId           String?
  payrolls        Payroll[]
  user            User        @relation(fields: [userId], references: [id])
  timesheets      Timesheet[]

  @@map("staff_profiles")
}

model Timesheet {
  id           String       @id @default(cuid())
  staffId      String       @map("staff_id")
  date         DateTime     @map("date")
  clockIn      DateTime     @map("clock_in")
  clockOut     DateTime?    @map("clock_out")
  breakMinutes Int          @default(0) @map("break_minutes")
  totalHours   Decimal?     @db.Decimal(5, 2)
  notes        String?
  approved     Boolean      @default(false)
  approvedBy   String?      @map("approved_by")
  staff        StaffProfile @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@map("timesheets")
}

model Payroll {
  id          String        @id @default(cuid())
  staffId     String        @map("staff_id")
  periodStart DateTime      @map("period_start")
  periodEnd   DateTime      @map("period_end")
  totalHours  Decimal       @db.Decimal(5, 2)
  hourlyRate  Decimal       @db.Decimal(10, 2)
  grossPay    Decimal       @db.Decimal(10, 2)
  deductions  Decimal       @default(0) @db.Decimal(10, 2)
  netPay      Decimal       @db.Decimal(10, 2)
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  paidAt      DateTime?
  notes       String?
  staff       StaffProfile  @relation(fields: [staffId], references: [id])

  @@map("payrolls")
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  expenseDate DateTime        @default(now()) @map("expense_date")
  receiptUrl  String?
  vendor      String?
  paidBy      String          @map("paid_by")
  createdAt   DateTime        @default(now())

  @@map("expenses")
}

model DailySalesSummary {
  id            String   @id @default(cuid())
  date          DateTime @unique
  totalBookings Int
  totalRevenue  Decimal  @db.Decimal(10, 2)
  totalExpenses Decimal  @db.Decimal(10, 2)
  netProfit     Decimal  @db.Decimal(10, 2)
  cashPayments  Decimal  @db.Decimal(10, 2)
  cardPayments  Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  @@map("daily_sales_summary")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  type        String
  title       String
  content     String
  isRead      Boolean   @default(false)
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValues Json?
  newValues Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  PARTIALLY_PAID
}

enum ExpenseCategory {
  SUPPLIES
  EQUIPMENT
  RENT
  UTILITIES
  SALARY
  MARKETING
  MAINTENANCE
  OTHER
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
}
